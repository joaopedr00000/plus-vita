if(NOT DEFINED PV_CA_INPUT OR NOT DEFINED PV_CA_OUTPUT)
  message(FATAL_ERROR "Set PV_CA_INPUT and PV_CA_OUTPUT")
endif()
file(READ "${PV_CA_INPUT}" pv_ca)
string(REPLACE "\r\n" "\n" pv_ca "${pv_ca}")
string(REGEX MATCHALL "-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\n]+-----END CERTIFICATE-----" pv_certs "${pv_ca}")
string(REGEX MATCHALL "-----BEGIN CERTIFICATE-----" pv_begins "${pv_ca}")
list(LENGTH pv_certs pv_count)
list(LENGTH pv_begins pv_expected)
if(pv_count LESS 100 OR NOT pv_count EQUAL pv_expected)
  message(FATAL_ERROR "Invalid or incomplete public CA bundle")
endif()
get_filename_component(pv_dir "${PV_CA_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${pv_dir}")
file(WRITE "${PV_CA_OUTPUT}" "/* Generated from committed public CA roots. */\n#ifndef PV_EMBEDDED_CA_H\n#define PV_EMBEDDED_CA_H\n#define PV_CA_CERT_COUNT ${pv_count}u\nstatic const char pv_ca_pem[] =\n")
foreach(pv_cert IN LISTS pv_certs)
  string(REPLACE "\n" "\\n\"\n\"" pv_literal "${pv_cert}")
  file(APPEND "${PV_CA_OUTPUT}" "\"${pv_literal}\\n\"\n")
endforeach()
file(APPEND "${PV_CA_OUTPUT}" ";\n#endif\n")
